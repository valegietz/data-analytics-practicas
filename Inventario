-- SECCIÓN DDL ─────────────────────────

DROP TABLE IF EXISTS inventario;

CREATE TABLE Inventario (
id_producto INT NOT NULL IDENTITY(1,1) PRIMARY KEY,  --Columna clave primaria, tipo de dato numero entero
nombre_producto VARCHAR(100),  --Nombre del producto, tipo de dato texto 100 caracteres
categoria VARCHAR(50),  --Nombre categoria, tipo de dato texto 50 caracteres
precio_unitario DECIMAL(10,2), --Precio, tipo de dato numero decimal hasta 10 digitos y dos decimales
stock_actual INT, --Cantidad disponible, Tipo de dato numero entero
stock_minimo INT,--Cantidad minima, Tipo de dato numero entero
fecha_ingreso DATE, --fecha de ingreso al inventario, tipo de dato fecha
activo TINYINT --Dato entero chico, 1=disponible y 0=discontinuado
);


